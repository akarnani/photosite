---
import Base from '../layouts/Base.astro';
import TripIndex from '../components/TripIndex.astro';
import { getTrips, coverPhoto, siteConfig, genresInUse } from '../lib/trips.js';
import { homeCard } from '../lib/ogCard.js';

const trips = getTrips();
const site = siteConfig();
const genres = genresInUse(trips);

// One genre: keep its own voice. Several: a neutral line that doesn't list them
// (the header nav already does).
const single = genres.length === 1 ? genres[0] : null;
const eyebrow = single ? single.eyebrow : 'Photography';
const tagline = single
  ? single.tagline
  : 'Trip by trip — where each frame was taken, and what turned up in front of the lens.';

const card = homeCard(trips, trips[0] ? coverPhoto(trips[0]) : null, site);
---

<Base genre={single?.id} image={{ path: card.path, alt: `${site.title} — ${eyebrow.toLowerCase()}` }}>
  <TripIndex trips={trips} eyebrow={eyebrow} heading={site.title} tagline={tagline} genreTags={genres.length > 1} />
</Base>
