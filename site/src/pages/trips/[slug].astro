---
import Base from '../../layouts/Base.astro';
import PhotoMap from '../../components/PhotoMap.astro';
import Gallery from '../../components/Gallery.astro';
import { getTrips, getTrip, pointsForTrip, coverPhoto, tripDescription, siteConfig } from '../../lib/trips.js';
import { tripCard } from '../../lib/ogCard.js';

export function getStaticPaths() {
  return getTrips().map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const trip = getTrip(slug);
const points = pointsForTrip(trip);
const eyebrow = [trip.location?.name, trip.dates].filter(Boolean).join(' · ');
const card = tripCard(trip, coverPhoto(trip), siteConfig());
---

<Base title={trip.title} description={tripDescription(trip)} image={{ path: card.path, alt: `${trip.title} — underwater photography` }}>
  <section class="stack">
    <div class="trip-head-row">
      <header class="trip-header">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{trip.title}</h1>
        {trip.summary && <p>{trip.summary}</p>}
        <p class="trip-count">
          {trip.photos.length} photographs
          {trip.photos.length > 10 && (
            <> · <a class="trip-fav" href={`/favorites/?trip=${trip.slug}`}>pick your favorites</a></>
          )}
        </p>
      </header>

      <PhotoMap points={points} id={`map-${trip.slug}`} height="230px" />
    </div>

    <Gallery photos={trip.photos} />
  </section>
</Base>
